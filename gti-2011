<script>
const photos=[
"images/gti-2011/01.jpg",
"images/gti-2011/02.jpg",
"images/gti-2011/03.jpg",
"images/gti-2011/04.jpg",
"images/gti-2011/05.jpg",
"images/gti-2011/06.jpg",
"images/gti-2011/07.jpg",
"images/gti-2011/08.jpg"
];

let index=0;
const img=document.getElementById("carPhoto");
const counter=document.getElementById("counter");

function showPhoto(){
img.src=photos[index];
counter.innerText=(index+1)+" / "+photos.length;
}

function nextPhoto(){
index=(index+1)%photos.length;
showPhoto();
}

function prevPhoto(){
index=(index-1+photos.length)%photos.length;
showPhoto();
}

showPhoto();
</script>

